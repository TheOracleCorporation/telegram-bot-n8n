      "parameters": {
        "jsCode": "// 1. Берём московское время консистентным способом для обеих дат\nconst now = new Date(new Date().toLocaleString(\"en-US\", {timeZone: \"Europe/Moscow\"}));\nconst semesterStartRaw = new Date(\"2026-09-01T00:00:00+03:00\");\nconst semesterStart = new Date(semesterStartRaw.toLocaleString(\"en-US\", {timeZone: \"Europe/Moscow\"}));\n\n// 2. Функция поиска понедельника той же недели\nfunction getMonday(d) {\n  const date = new Date(d);\n  const day = date.getDay(); // 0=Вс, 1=Пн, ..., 6=Сб\n  const diff = date.getDate() - day + (day === 0 ? -6 : 1);\n  const result = new Date(date);\n  result.setDate(diff);\n  result.setHours(0, 0, 0, 0);\n  return result;\n}\n\nconst mondayOfNow = getMonday(now);\nconst mondayOfWeek1 = getMonday(semesterStart);\n\n// 3. Считаем номер недели через разницу понедельников\nconst diffDays = Math.round((mondayOfNow - mondayOfWeek1) / (1000 * 3600 * 24));\nconst currentWeekNumber = Math.floor(diffDays / 7) + 1;\nconst isEvenWeek = (currentWeekNumber % 2 === 0);\nconst oppositeWeekType = isEvenWeek ? \"нечетная\" : \"четная\";\n\n// 4. Определяем день недели на русском\nconst days = ['Воскресенье', 'Понедельник', 'Вторник', 'Среда', 'Четверг', 'Пятница', 'Суббота'];\nconst currentDay = days[now.getDay()];\n\n// 5. Парсим CSV из поля data\nconst inputData = $input.item.json.data || \"\";\nconst lines = inputData.split('\\n').map(line => line.trim()).filter(line => line.length > 0);\nconst headers = lines[0].split(',');\nconst allRows = lines.slice(1).map(line => {\n  const values = line.split(',');\n  const rowObj = {};\n  headers.forEach((header, index) => {\n    rowObj[header.trim()] = values[index] ? values[index].trim() : \"\";\n  });\n  return { json: rowObj };\n});\n\n// 6. Фильтруем пары\nconst todaysLessons = allRows.filter(row => {\n  const dayValue = (row.json['День'] || row.json['день'] || '').trim().toLowerCase();\n  const weekValue = (row.json['Неделя'] || row.json['неделя'] || '').trim().toLowerCase();\n  if (dayValue !== currentDay.toLowerCase()) return false;\n  if (weekValue === oppositeWeekType) return false;\n  return true;\n});\n\n// 7. Формируем текст\nlet message = `📅 *Расписание на сегодня (${currentDay})*\\n`;\nmessage += `🔥 Неделя №${currentWeekNumber} (${isEvenWeek ? \"Четная\" : \"Нечетная\"})\\n\\n`;\n\nif (todaysLessons.length === 0) {\n  message += \"🎉 Пар по расписанию нет! Отдыхаем.\";\n} else {\n  todaysLessons.sort((a, b) => (a.json['Начало'] || '').localeCompare(b.json['Начало'] || ''));\n  todaysLessons.forEach((lesson, index) => {\n    const start = lesson.json['Начало'] || '??:??';\n    const end = lesson.json['Конец'] || '??:??';\n    const name = lesson.json['Пара'] || 'Предмет';\n    const room = lesson.json['Аудитория'] || 'Не указана';\n    const type = lesson.json['Тип занятия'] || '';\n    const note = lesson.json['Неделя'] || 'Постоянно';\n    message += `*${index + 1} пара* | ⏰ *${start} - ${end}*\\n`;\n    message += `📚 *${name}* [${type}]\\n`;\n    message += `🚪 Аудитория: ${room} (_${note}_)\\n\\n`;\n  });\n}\n\nreturn [{ json: { text: message } }];"
      },
