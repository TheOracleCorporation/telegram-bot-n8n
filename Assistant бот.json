    {
      "parameters": {
        "jsCode": "// 1. Получаем текст CSV из таблицы Объявлений\nconst csvText = $input.first().json.data;\nif (!csvText) return [{ json: { messageText: \"📢 **Важные объявления:**\\n\\nНе удалось загрузить новости.\" } }];\n\n// 2. Функция для разбиения CSV строки по ЗАПЯТОЙ\nfunction parseCSVLine(text) {\n  if (!text) return [];\n  const result = [];\n  let current = '';\n  let inQuotes = false;\n  for (let i = 0; i < text.length; i++) {\n    const char = text[i];\n    if (char === '\"') inQuotes = !inQuotes;\n    else if (char === ',' && !inQuotes) {\n      result.push(current.trim().replace(/^\"+|\"+$/g, ''));\n      current = '';\n    } else current += char;\n  }\n  result.push(current.trim().replace(/^\"+|\"+$/g, ''));\n  return result;\n}\n\n// 3. Разбиваем текст на строки\nconst lines = csvText.split(/\\r?\\n/).map(line => line.trim()).filter(line => line.length > 0);\nif (lines.length <= 1) return [{ json: { messageText: \"📢 **Важные объявления:**\\n\\nНовостей пока нет.\" } }];\n\n// Извлекаем заголовки из первой строки\nconst headers = parseCSVLine(lines[0]).map(h => h.replace(/^\\uFEFF/, '').trim());\n\nlet messageText = \"📢 **Важные объявления:**\\n\\n\";\nlet hasNews = false;\nlet newsCount = 0; // Счетчик добавленных объявлений\n\n// 4. Перебираем строки с объявлениями\nfor (let i = 1; i < lines.length; i++) {\n  if (newsCount >= 5) break; // Прерываем цикл, если уже добавили 5 объявлений\n\n  const currentLine = parseCSVLine(lines[i]);\n  const row = {};\n  \n  headers.forEach((header, index) => {\n    if (header) row[header] = (currentLine[index] || '').trim();\n  });\n\n  const newsText = row['Объявления'] || row['Объявление'];\n  const newsDate = row['Дата'] || \"Не указана\";\n\n  if (newsText) {\n    messageText += `📅 **[${newsDate}]**:\\nℹ️ ${newsText}\\n`;\n    messageText += \"─────────────────\\n\\n\";\n    hasNews = true;\n    newsCount++; // Увеличиваем счетчик\n  }\n}\n\n// 5. Если в таблице не оказалось заполненных новостей\nif (!hasNews) {\n  messageText = \"📢 **Важные объявления:**\\n\\nНовостей пока нет.\";\n}\n\n// 6. Возвращаем готовый отформатированный текст для Telegram\nreturn [{ json: { messageText: messageText.trim() } }];\n"
      },
