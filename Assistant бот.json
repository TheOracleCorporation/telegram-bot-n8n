    {
      "parameters": {
        "jsCode": "// 1. Получаем текст CSV из таблицы Домашки\nconst csvText = $input.first().json.data;\nif (!csvText) return [{ json: { message: \"Домашка временно недоступна.\" } }];\n\n// 2. Функция для правильного разбиения CSV строки по ЗАПЯТОЙ\nfunction parseCSVLine(text) {\n  if (!text) return [];\n  const result = [];\n  let current = '';\n  let inQuotes = false;\n  for (let i = 0; i < text.length; i++) {\n    const char = text[i];\n    if (char === '\"') inQuotes = !inQuotes;\n    else if (char === ',' && !inQuotes) {\n      result.push(current.trim().replace(/^\"+|\"+$/g, ''));\n      current = '';\n    } else current += char;\n  }\n  result.push(current.trim().replace(/^\"+|\"+$/g, ''));\n  return result;\n}\n\n// 3. Разбиваем текст на строки\nconst lines = csvText.split(/\\r?\\n/).map(line => line.trim()).filter(line => line.length > 0);\nif (lines.length <= 1) return [{ json: { message: \"📝 **Актуальные домашние задания:**\\n\\nЗаданий пока нет.\" } }];\n\n// Извлекаем заголовки\nconst headers = parseCSVLine(lines[0]).map(h => h.replace(/^\\uFEFF/, '').trim());\n\n// Массив для хранения только уникальных последних заданий\nconst uniqueHomework = [];\n// Набор для отслеживания уже добавленных предметов\nconst seenSubjects = new Set();\n\n// Перебираем строки ТАБЛИЦЫ СНИЗУ ВВЕРХ (от самых свежих к старым)\nfor (let i = lines.length - 1; i >= 1; i--) {\n  const currentLine = parseCSVLine(lines[i]);\n  const row = {};\n  \n  headers.forEach((header, index) => {\n    if (header) row[header] = (currentLine[index] || '').trim();\n  });\n\n  const subject = row['Предмет'];\n  const task = row['Задание'];\n\n  if (subject && task) {\n    const cleanSubject = subject.toLowerCase();\n    \n    // Если мы этот предмет еще не встречали, значит это самое последнее задание по нему\n    if (!seenSubjects.has(cleanSubject)) {\n      seenSubjects.add(cleanSubject);\n      uniqueHomework.push(row); // Сохраняем строку\n    }\n  }\n}\n\nif (uniqueHomework.length === 0) {\n  return [{ json: { message: \"📝 **Актуальные домашние задания:**\\n\\nЗаданий пока нет.\" } }];\n}\n\n// Опционально: сортируем предметы по алфавиту для красоты вывода\nuniqueHomework.sort((a, b) => a['Предмет'].localeCompare(b['Предмет']));\n\n// 4. Формируем текст сообщения\nlet message = \"📝 **Последние домашние задания по предметам:**\\n\\n\";\n\nuniqueHomework.forEach((item) => {\n  const date = item['Дата'] || \"⏳\";\n  const subject = item['Предмет'];\n  const task = item['Задание'];\n\n  message += `📅 **${date}** | 📘 **${subject}**:\\n💬 *\"${task}\"*\\n`;\n  message += \"─────────────────\\n\\n\";\n});\n\nreturn [{ json: { message: message.trim() } }];\n"
      },
